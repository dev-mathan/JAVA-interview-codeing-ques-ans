class Main {
    public static void main(String[] args) {
        int [] arr = {20 , 30 , 40 ,50, 60};
        int second_large =0;
        int largest = arr[0];
        
        for(int i = 0 ; i < arr.length; i++){
            if(arr[i] > largest){
                largest = arr[i];
            }
        }
        
        for(int j = 0; j < arr.length; j++){
            if(arr[j] < largest && arr[j] != largest){
                second_large = arr[j];
            }
        }
        System.out.print(second_large);
    }
}
